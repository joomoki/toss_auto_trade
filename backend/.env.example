# PostgreSQL
DATABASE_URL=postgresql+asyncpg://toss_stock:PASSWORD@localhost:5432/toss_auto_trade

# Redis
REDIS_URL=redis://localhost:6379/0

# 키움증권 Open API REST  (https://openapi.kiwoom.com 에서 발급)
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_SECRET_KEY=your_secret_key_here
# 계좌번호 (비워두면 첫 번째 계좌 자동 사용)
KIWOOM_ACCOUNT_NO=

# 텔레그램 알림 (BotFather에서 봇 생성 후 발급, 비워두면 알림 비활성)
# 봇 생성: https://t.me/BotFather → /newbot → 토큰 발급
# Chat ID: 봇에게 아무 메시지 보낸 후 https://api.telegram.org/bot{TOKEN}/getUpdates 로 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 자동매매 설정
AUTO_TRADE_ENABLED=false
SIGNAL_INTERVAL_MINUTES=5
MAX_HOLDINGS=10

# ML 모델
MODEL_PATH=./app/ml/models/lgbm_v1.pkl
